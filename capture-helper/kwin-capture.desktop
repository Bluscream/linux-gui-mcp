[Desktop Entry]
Type=Application
Name=kwin-capture
Comment=Screen capture helper for linux-gui-mcp
Exec=/run/media/system/Data/Projects/MCPs/linux-gui-mcp/capture-helper/target/release/kwin-capture
NoDisplay=true
Terminal=false
# KWin grants ScreenShot2 by looking up the calling executable's desktop file,
# which is how spectacle, plasmashell and the xdg portal each authorise
# themselves. Granting it to a Python interpreter would hand screen capture to
# every Python program on this machine; this grants it to one binary that
# captures the screen and does nothing else.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
